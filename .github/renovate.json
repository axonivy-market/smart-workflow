{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>axonivy-market/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "/^dev\\.langchain4j:.*/"
      ],
      "groupName": "langchain4j"
    },
    {
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "dev.langchain4j:langchain4j-community-web-search-engine-duckduckgo"
      ],
      "ignoreUnstable": false
    }
  ]
}
