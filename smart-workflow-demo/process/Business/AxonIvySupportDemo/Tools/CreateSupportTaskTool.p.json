{
  "$schema" : "https://json-schema.axonivy.com/14.0/project/process.json",
  "id" : "19951D4300D918C9",
  "kind" : "CALLABLE_SUB",
  "config" : {
    "data" : "Business.AxonIvySupportDemo.Tools.CreateSupportTaskToolData"
  },
  "elements" : [ {
      "id" : "f37",
      "type" : "CallSubStart",
      "name" : "createAxonIvySupportTicket(String)",
      "config" : {
        "signature" : "createAxonIvySupportTicket",
        "input" : {
          "params" : [
            { "name" : "ticketDescription", "type" : "String", "desc" : "The user's full problem report in their own words, including the product version and any error message or stack trace they gave" }
          ],
          "map" : {
            "out.ticketDescription" : "param.ticketDescription"
          }
        },
        "result" : {
          "params" : [
            { "name" : "supportTicket", "type" : "com.axonivy.utils.smart.workflow.demo.dto.AxonIvySupportTicket", "desc" : "" },
            { "name" : "responseMessage", "type" : "String", "desc" : "" }
          ],
          "map" : {
            "result.supportTicket" : "in.supportTicket",
            "result.responseMessage" : "in.responseMessage"
          }
        }
      },
      "tags" : [
        "tool"
      ],
      "visual" : {
        "at" : { "x" : 96, "y" : 64 },
        "description" : "Step 1 of reporting a problem with Axon Ivy Core, Portal or a Market product: turns the user's problem report into a support ticket with category, title, product version, operating system and stack trace. Returns the ticket and a message saying whether it is complete or which information to ask the user for."
      },
      "connect" : [
        { "id" : "f38", "to" : "f39" }
      ]
    }, {
      "id" : "f39",
      "type" : "Script",
      "name" : "Create ticket object",
      "config" : {
        "output" : {
          "code" : [
            "import com.axonivy.utils.smart.workflow.demo.dto.AxonIvySupportTicket;",
            "",
            "in.supportTicket = new AxonIvySupportTicket();",
            "in.supportTicket.setDescription(in.ticketDescription);"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 232, "y" : 64 }
      },
      "connect" : [
        { "id" : "f40", "to" : "f41" }
      ]
    }, {
      "id" : "f41",
      "type" : "ProgramInterface",
      "name" : "Use AI to create support ticket object",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "system" : "Instruction to follow:\n- Don't fill information related to approval\n- Find Ivy version or Portal version or Core version\n<%=in.customInstructions%>",
          "resultType" : "com.axonivy.utils.smart.workflow.demo.dto.AxonIvySupportTicket.class",
          "tools" : "",
          "resultMapping" : "in.supportTicket",
          "query" : "<%=in.ticketDescription%>"
        }
      },
      "visual" : {
        "at" : { "x" : 400, "y" : 64 }
      },
      "connect" : [
        { "id" : "f42", "to" : "f43" }
      ]
    }, {
      "id" : "f43",
      "type" : "Script",
      "name" : "Check missing information",
      "config" : {
        "output" : {
          "code" : [
            "import org.apache.commons.lang3.StringUtils;",
            "import org.apache.commons.lang3.Strings;",
            "",
            "if (StringUtils.isBlank(in.supportTicket.version)) {",
            "  in.responseMessage = \"The product version is missing. Ask the user for it, then create the support ticket again.\";",
            "} else if (Strings.CI.containsAny(in.ticketDescription, \"error\", \"exception\") && StringUtils.isBlank(in.supportTicket.stackTrace)) {",
            "  in.responseMessage = \"The stack trace is missing. Ask the user for it, then create the support ticket again.\";",
            "} else {",
            "  in.responseMessage = \"The support ticket is complete. Pass it unchanged to createAxonIvySupportTaskInfo.\";",
            "}"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 568, "y" : 64 }
      },
      "connect" : [
        { "id" : "f44", "to" : "f45" }
      ]
    }, {
      "id" : "f45",
      "type" : "CallSubEnd",
      "visual" : {
        "at" : { "x" : 712, "y" : 64 }
      }
    }, {
      "id" : "f46",
      "type" : "CallSubStart",
      "name" : "createAxonIvySupportTaskInfo(com.axonivy.utils.smart.workflow.demo.dto.AxonIvySupportTicket)",
      "config" : {
        "signature" : "createAxonIvySupportTaskInfo",
        "input" : {
          "params" : [
            { "name" : "supportTicket", "type" : "com.axonivy.utils.smart.workflow.demo.dto.AxonIvySupportTicket", "desc" : "The complete support ticket exactly as createAxonIvySupportTicket returned it" }
          ],
          "map" : {
            "out.supportTicket" : "param.supportTicket",
            "out.ticketDescription" : "param.#supportTicket.#description"
          }
        },
        "result" : {
          "params" : [
            { "name" : "responseMessage", "type" : "String", "desc" : "" }
          ],
          "map" : {
            "result.responseMessage" : "in.responseMessage"
          }
        }
      },
      "tags" : [
        "tool"
      ],
      "visual" : {
        "at" : { "x" : 96, "y" : 200 },
        "description" : "Step 2 of reporting a problem: creates the task info for a complete support ticket and the task for the support team. Use it only after createAxonIvySupportTicket said the ticket is complete."
      },
      "connect" : [
        { "id" : "f54", "to" : "f48" }
      ]
    }, {
      "id" : "f48",
      "type" : "Alternative",
      "name" : "has ticket?",
      "config" : {
        "conditions" : {
          "f49" : "in.supportTicket != null && in.supportTicket.type != null"
        }
      },
      "visual" : {
        "at" : { "x" : 352, "y" : 200 },
        "labelOffset" : { "y" : -24 }
      },
      "connect" : [
        { "id" : "f49", "to" : "f17" },
        { "id" : "f50", "to" : "f51" }
      ]
    }, {
      "id" : "f17",
      "type" : "ProgramInterface",
      "name" : "Use AI to create task info",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "runtimeTools" : "",
          "system" : "Instruction to follow:\n- Return task detail url\n- Describe the task from the support ticket: its category, product version, operating system and stack trace\n<%=in.customInstructions%>",
          "resultType" : "com.axonivy.utils.smart.workflow.demo.dto.TaskInfo.class",
          "tools" : "",
          "resultMapping" : "in.taskInfo",
          "query" : "User report:\n<%=in.ticketDescription%>\n\nSupport ticket:\n<%= dev.langchain4j.internal.Json.toJson(in.supportTicket) %>"
        }
      },
      "visual" : {
        "at" : { "x" : 520, "y" : 200 }
      },
      "connect" : [
        { "id" : "f18", "to" : "f35" }
      ]
    }, {
      "id" : "f35",
      "type" : "Script",
      "name" : "Preserve responsible",
      "config" : {
        "output" : {
          "code" : "in.taskInfo.responsible = in.supportTicket.type.getRoleName();"
        }
      },
      "visual" : {
        "at" : { "x" : 688, "y" : 200 }
      },
      "connect" : [
        { "id" : "f36", "to" : "f24" }
      ]
    }, {
      "id" : "f24",
      "type" : "TriggerCall",
      "name" : "Create task for support team",
      "config" : {
        "processCall" : "Business/AxonIvySupport:createTaskForSupportTeam(com.axonivy.utils.smart.workflow.demo.dto.AxonIvySupportTicket,com.axonivy.utils.smart.workflow.demo.dto.TaskInfo)",
        "call" : {
          "map" : {
            "param.supportTicket" : "in.supportTicket",
            "param.taskInfo" : "in.taskInfo"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 856, "y" : 200 }
      },
      "connect" : [
        { "id" : "f25", "to" : "f26", "color" : "default" }
      ]
    }, {
      "id" : "f26",
      "type" : "Script",
      "name" : "Create response messgage",
      "config" : {
        "output" : {
          "code" : "in.responseMessage = \"Task for support ticket is created!\";"
        }
      },
      "visual" : {
        "at" : { "x" : 1024, "y" : 200 }
      },
      "connect" : [
        { "id" : "f27", "to" : "f28", "color" : "default" }
      ]
    }, {
      "id" : "f28",
      "type" : "CallSubEnd",
      "visual" : {
        "at" : { "x" : 1184, "y" : 200 }
      }
    }, {
      "id" : "f51",
      "type" : "Script",
      "name" : "Missing ticket",
      "config" : {
        "output" : {
          "code" : "in.responseMessage = \"No support ticket was given. Call createAxonIvySupportTicket first and pass its ticket unchanged.\";"
        }
      },
      "visual" : {
        "at" : { "x" : 520, "y" : 304 }
      },
      "connect" : [
        { "id" : "f52", "to" : "f53" }
      ]
    }, {
      "id" : "f53",
      "type" : "CallSubEnd",
      "visual" : {
        "at" : { "x" : 688, "y" : 304 }
      }
    } ]
}